# Copier vers .env. Les clés restent exclusivement côté serveur.
DATABASE_URL="file:./studio.db"
STORAGE_DIR="./storage"
# Facultatif : requis uniquement pour les générations Runway payantes.
RUNWAY_API_KEY=""
# Facultatif : chemins absolus si FFmpeg / FFprobe ne sont pas dans PATH.
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# Déploiement futur uniquement : origine publique exacte après création locale du mot de passe.
# APP_ORIGIN="https://studio.example.com"

# Phase 3 : service ComfyUI facultatif. La planche locale fonctionne sans lui.
COMFYUI_URL="http://127.0.0.1:8188"
# Deux fichiers JSON distincts, exportés/configurés selon docs/PHASE_3.md.
COMFYUI_FASHION_WORKFLOW=""
COMFYUI_TRYON_WORKFLOW=""

# Police locale facultative pour les textes du montage si aucune police système n’est trouvée.
# FFMPEG_FONT_PATH="/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"

# Phase 5 : Replicate facultatif, désactivé dans l’application par défaut.
# Choisir une version de modèle acceptant {prompt, image?} ; voir docs/PHASE_5.md.
REPLICATE_API_TOKEN=""
REPLICATE_MODEL_VERSION=""
REPLICATE_OUTPUT_KIND="image"
# Réservation manuelle EUR par prédiction, pas un devis ni un plafond fournisseur.
# Entier positif en centimes à définir avant activation ; vide bloque les envois.
REPLICATE_ESTIMATE_CENTS=""

# Ollama facultatif : modèle déjà installé sur un service en boucle locale.
# Aucun téléchargement de modèle n’est lancé par le studio.
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL=""

# Voix du studio de contenus : Piper facultatif, modèles déjà installés.
# Un fichier de configuration .onnx.json avec sa langue doit accompagner chaque modèle.
# Aucun téléchargement ou abonnement n'est déclenché par ces options.
CREATOR_PIPER_PATH=""
CREATOR_PIPER_MODEL_FR=""
CREATOR_PIPER_MODEL_EN=""
