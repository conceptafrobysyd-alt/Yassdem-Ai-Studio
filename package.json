{
  "name": "yassdem-ai-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker \"next dev --hostname 127.0.0.1\" \"tsx src/worker.ts\"",
    "dev:web": "next dev --hostname 127.0.0.1",
    "worker": "tsx src/worker.ts",
    "build": "next build --webpack",
    "start": "concurrently -k -n web,worker \"next start --hostname 127.0.0.1\" \"tsx src/worker.ts\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:launcher": "node --test scripts/start-studio.test.mjs",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:smoke:fashion": "tsx scripts/smoke-fashion.ts",
    "test:smoke:editor": "tsx scripts/smoke-editor.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "6.19.0",
    "archiver": "^7.0.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@prisma/config@6.19.0": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.3"
    },
    "@prisma/adapter-better-sqlite3@6.19.0": {
      "better-sqlite3": "12.11.1"
    }
  }
}
